NODE_ENV=development
PORT=3456

DATABASE_PATH=./data/vision_support_desk.db

# IANA zone name. Used for log timestamps and the org's default Time_Zone.
TIMEZONE=Asia/Kolkata

# File logging: writes logs/<date>.log (+ logs/error-<date>.log for errors),
# one file per calendar day, in addition to the console.
LOG_TO_FILE=true
LOG_DIR=logs

# Where attachment bytes from Gmail ingestion (and future direct uploads)
# are stored on disk.
ATTACHMENTS_DIR=./uploads/attachments

# JWT (future Login & Security module - not wired into any route yet)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Google Cloud / Gmail API OAuth client (see docs/ for Gmail Console setup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3456/api/v1/gmail/oauth2callback
GOOGLE_REFRESH_TOKEN=

# Mailbox the Gmail ingestion engine authenticates as and pulls mail for.
GMAIL_MAILBOX=

# Background sync job: automatically calls the ingestion engine on an
# interval instead of requiring a manual POST /api/v1/gmail/sync.
GMAIL_SYNC_ENABLED=true
GMAIL_SYNC_INTERVAL_MS=60000
